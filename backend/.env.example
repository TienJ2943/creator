SEEDANCE_API_KEY=seedance_api_key
# SEEDANCE_API_URL is the Ark base URL only, e.g. https://ark.ap-southeast.bytepluses.com/api/v3
# (the /contents/generations/tasks path is appended by the backend)
SEEDANCE_API_URL=seedance_api_url
# PUBLIC_BACKEND_URL must be a publicly reachable URL (not localhost) in any
# deployment where real Seedance/Ark video generation is used - the Ark API
# fetches the uploaded source video from "{PUBLIC_BACKEND_URL}/media/uploads/...",
# so BytePlus's servers need to be able to reach this URL over the internet.
# The localhost default below only works for local-only/mocked testing.
PUBLIC_BACKEND_URL=http://localhost:8000
ANTHROPIC_API_KEY=
X_BEARER_TOKEN=
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
THREADS_ACCESS_TOKEN=
